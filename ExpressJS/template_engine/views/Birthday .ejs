<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Birthday Invitation</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ffd6e7, #d9e7ff);
        }

        .card {
            width: 400px;
            padding: 40px 30px;
            text-align: center;
            background: white;
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

        .emoji {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .small-title {
            color: #777;
            font-size: 16px;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        h1 {
            color: #ff4f81;
            font-size: 42px;
            margin: 10px 0;
        }

        .name {
            font-size: 30px;
            color: #333;
            margin-bottom: 20px;
        }

        .message {
            color: #666;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .details {
            background: #fff1f6;
            padding: 18px;
            border-radius: 15px;
            margin-bottom: 25px;
        }

        .details p {
            margin: 8px 0;
            color: #444;
        }

        .button {
            display: inline-block;
            padding: 12px 25px;
            background: #ff4f81;
            color: white;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
        }

        .footer {
            margin-top: 25px;
            color: #999;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <div class="card">

        <div class="emoji">🎂🎈</div>

        <p class="small-title">You are invited to</p>

        <h1>Birthday Party</h1>

        <div class="name">
            <%= name %>
        </div>

        <p class="message">
            Join us to celebrate a wonderful birthday
            filled with fun, laughter, cake and unforgettable memories!
        </p>

        <div class="details">
            <p>📅 <strong>Date:</strong> <%= date %></p>
            <p>⏰ <strong>Time:</strong> <%= time %></p>
            <p>📍 <strong>Venue:</strong> <%= venue %></p>
        </div>

        <a href="#" class="button">You're Invited 🎉</a>

        <p class="footer">
            We can't wait to celebrate with you!
        </p>

    </div>

</body>

</html>
