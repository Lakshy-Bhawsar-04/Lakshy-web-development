-->30. Prototype & Inheritance

==> 77. Explain prototypal inheritance.
Answer:  
Objects inherit properties from other objects via prototypes. You can set an object's prototype using `Object.create()` or `__proto__`.

Example:
----------------JS----------------------
const person = {
  greet() { console.log('Hello'); }
};
const student = Object.create(person);
student.study = () => console.log('Studying');

student.greet(); // Hello
student.study(); // Studying
-----------------------------------------

==> 78. Constructor function vs class syntax.
----------------JS----------------------
// Constructor function
function Person(name) {
  this.name = name;
}
Person.prototype.sayHello = function() {
  console.log(`Hello, my name is ${this.name}`);
};

// ES6 class
class Person {
  constructor(name) {
    this.name = name;
  }
  sayHello() {
    console.log(`Hello, my name is ${this.name}`);
  }
}
-----------------------------------------

---

-->31. Modern JavaScript APIs & Patterns

==> 79. Using `Proxy` for reactive programming.
----------------JS----------------------
const handler = {
  get(target, prop) {
    console.log(`Getting ${prop}`);
    return target[prop];
  },
  set(target, prop, value) {
    console.log(`Setting ${prop} to ${value}`);
    target[prop] = value;
    return true;
  }
};

const obj = new Proxy({ name: 'Alice' }, handler);
console.log(obj.name); // Getting name, Alice
obj.name = 'Bob'; // Setting name to Bob
-----------------------------------------

==> 80. Using `async/await` with error handling.
----------------JS----------------------
async function fetchData() {
  try {
    const response = await fetch('https://api.example.com/data');
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    console.log(data);
  } catch (error) {
    console.error('Fetch error:', error);
  }
}
fetchData();
-----------------------------------------

