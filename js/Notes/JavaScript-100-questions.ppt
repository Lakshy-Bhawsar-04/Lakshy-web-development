-->38. Design Patterns in JavaScript

==> 94. Singleton Pattern.
Implementation:
----------------JS----------------------
const Singleton = (function() {
  let instance;

  function createInstance() {
    const object = new Object('I am the instance');
    return object;
  }

  return {
    getInstance() {
      if (!instance) {
        instance = createInstance();
      }
      return instance;
    }
  };
})();

const instance1 = Singleton.getInstance();
const instance2 = Singleton.getInstance();

console.log(instance1 === instance2); // true
-----------------------------------------

---

==> 95. Observer Pattern.
Implementation:
----------------JS----------------------
class Subject {
  constructor() {
    this.observers = [];
  }

  subscribe(observer) {
    this.observers.push(observer);
  }

  unsubscribe(observer) {
    this.observers = this.observers.filter(obs => obs !== observer);
  }

  notify(data) {
    this.observers.forEach(observer => observer.update(data));
  }
}

class Observer {
  constructor(name) {
    this.name = name;
  }

  update(data) {
    console.log(`${this.name} received data: ${data}`);
  }
}

// Usage:
const subject = new Subject();
const obs1 = new Observer('Observer1');
const obs2 = new Observer('Observer2');

subject.subscribe(obs1);
subject.subscribe(obs2);

subject.notify('Hello Observers!');
-----------------------------------------

---

-->39. Error Handling & Robust Code

==> 96. How to handle multiple asynchronous errors?
Answer:  
Use `Promise.allSettled()` which returns an array of results with statuses, allowing handling of individual promise rejections without aborting the entire process.

----------------JS----------------------
const promises = [
  fetch('https://api.example.com/data1'),
  fetch('https://api.example.com/data2')
];

Promise.allSettled(promises)
  .then(results => results.forEach(result => {
    if (result.status === 'fulfilled') {
      console.log('Data:', result.value);
    } else {
      console.error('Error:', result.reason);
    }
  }));
-----------------------------------------

==> 97. Best practices for error handling in async functions.
- Always use `try-catch` blocks.
- Handle rejected promises explicitly.
- Return meaningful error messages.

