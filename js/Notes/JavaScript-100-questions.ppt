==> 76. Loop with closures mistake.
----------------JS----------------------
// Common mistake:
for (var i = 0; i < 3; i++) {
  setTimeout(() => console.log(i), 100);
}
// Output: 3, 3, 3

// Corrected with IIFE:
for (var i = 0; i < 3; i++) {
  ((index) => {
    setTimeout(() => console.log(index), 100);
  })(i);
}
// Output: 0, 1, 2
-----------------------------------------

